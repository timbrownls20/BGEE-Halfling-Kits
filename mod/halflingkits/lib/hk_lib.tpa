/////////////////////////////////////////////////////////////////////
// Halfling Kits shared library
//
// Helpers every kit uses: building spells from scratch, reading data
// from vanilla spells and tables, building the 2DA lines ADD_KIT needs,
// and restricting items to a kit's allowed weapons and armour.
/////////////////////////////////////////////////////////////////////

// Spell type values (SPL offset 0x1c)
OUTER_SET HK_SPELL_INNATE = 4

// Effect timing modes
OUTER_SET HK_TIMING_DURATION      = 0
OUTER_SET HK_TIMING_INSTANT       = 1
OUTER_SET HK_TIMING_DELAYED       = 4
OUTER_SET HK_TIMING_PERMANENT     = 9   // survives death; used for kit passives

// Ability header target types
OUTER_SET HK_TARGET_CASTER = 5

// One turn in seconds, and one game day in seconds (1 game hour = 300 s)
OUTER_SET HK_ONE_TURN = 60
OUTER_SET HK_ONE_DAY  = 7200


/////////////////////////////////////////////////////////////////////
// HK_INIT_SPELL (patch)
// Turns a freshly CREATEd SPL into an empty spell with the given name,
// description, type and icon. No ability headers or effects.
/////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION HK_INIT_SPELL
  INT_VAR name  = "-1"
          desc  = "-1"
          type  = 4
          level = 1
  STR_VAR icon  = ""
BEGIN
  WRITE_LONG   0x08 name
  WRITE_LONG   0x0c "-1"
  WRITE_SHORT  0x1c type
  WRITE_LONG   0x34 level
  WRITE_ASCIIE 0x3a ~%icon%~ #8
  WRITE_LONG   0x50 desc
  WRITE_LONG   0x54 desc
  WRITE_LONG   0x64 0x72   // ability headers start straight after the main header
  WRITE_SHORT  0x68 0
  WRITE_LONG   0x6a 0x72   // effects follow the ability headers
  WRITE_SHORT  0x6e 0
  WRITE_SHORT  0x70 0
END


/////////////////////////////////////////////////////////////////////
// HK_ADD_SPELL_HEADER (patch)
// Appends an ability header. Add headers in ascending min_level order:
// the engine uses the highest header the caster's level qualifies for.
// Add all headers before any effects.
/////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION HK_ADD_SPELL_HEADER
  INT_VAR location     = 4    // 4 = innate
          target       = 5    // 5 = caster
          target_count = 0
          range        = 0
          min_level    = 1
          speed        = 0
          projectile   = 1    // 1 = none
  STR_VAR icon         = ""
BEGIN
  READ_LONG  0x64 hdr_off
  READ_SHORT 0x68 hdr_cnt
  READ_LONG  0x6a fx_off

  // New header's first effect sits after every effect already owned by
  // earlier headers.
  SET fx_index = 0
  FOR (i = 0; i < hdr_cnt; ++i) BEGIN
    READ_SHORT (hdr_off + i * 0x28 + 0x1e) cnt
    READ_SHORT (hdr_off + i * 0x28 + 0x20) idx
    PATCH_IF (idx + cnt > fx_index) BEGIN
      SET fx_index = idx + cnt
    END
  END

  SET new = hdr_off + hdr_cnt * 0x28
  INSERT_BYTES new 0x28
  WRITE_BYTE   new          1   // spell form: standard
  WRITE_SHORT  (new + 0x02) location
  WRITE_ASCIIE (new + 0x04) ~%icon%~ #8
  WRITE_BYTE   (new + 0x0c) target
  WRITE_BYTE   (new + 0x0d) target_count
  WRITE_SHORT  (new + 0x0e) range
  WRITE_SHORT  (new + 0x10) min_level
  WRITE_SHORT  (new + 0x12) speed
  WRITE_SHORT  (new + 0x1e) 0
  WRITE_SHORT  (new + 0x20) fx_index
  WRITE_SHORT  (new + 0x22) 1   // charges
  WRITE_SHORT  (new + 0x26) projectile

  WRITE_SHORT 0x68 (hdr_cnt + 1)
  PATCH_IF (fx_off >= new) BEGIN
    WRITE_LONG 0x6a (fx_off + 0x28)
  END
END


/////////////////////////////////////////////////////////////////////
// HK_SPELL_FX (patch)
// ADD_SPELL_EFFECT with the defaults the kits use: targets the caster,
// not dispellable. header = 0 adds to every header.
/////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION HK_SPELL_FX
  INT_VAR opcode        = 0
          target        = 1
          parameter1    = 0
          parameter2    = 0
          timing        = 0
          duration      = 0
          resist_dispel = 0
          special       = 0
          header        = 0
          savingthrow   = 0
          dicenumber    = 0
          dicesize      = 0
  STR_VAR resource      = ""
BEGIN
  LPF ADD_SPELL_EFFECT
    INT_VAR opcode
            target
            parameter1
            parameter2
            timing
            duration
            resist_dispel
            special
            header
            savingthrow
            dicenumber
            dicesize
            power = 0
            probability1 = 100
            probability2 = 0
    STR_VAR resource
  END
END


/////////////////////////////////////////////////////////////////////
// HK_READ_SPELL_AREA (action)
// Reads the first ability header of a vanilla spell so a new spell can
// reuse its targeting (for example, Bless's party-only area).
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_READ_SPELL_AREA
  STR_VAR spell = ""
  RET found projectile target range icon book_icon
BEGIN
  OUTER_SET found      = 0
  OUTER_SET projectile = 1
  OUTER_SET target     = HK_TARGET_CASTER
  OUTER_SET range      = 0
  OUTER_SPRINT icon      ~~
  OUTER_SPRINT book_icon ~~
  ACTION_IF (FILE_EXISTS_IN_GAME ~%spell%.spl~) BEGIN
    COPY_EXISTING ~%spell%.spl~ ~override~
      READ_ASCII 0x3a book_icon (8) NULL
      READ_LONG  0x64 hdr_off
      READ_SHORT 0x68 hdr_cnt
      PATCH_IF (hdr_cnt > 0) BEGIN
        SET found = 1
        READ_ASCII (hdr_off + 0x04) icon (8) NULL
        READ_BYTE  (hdr_off + 0x0c) target
        READ_SHORT (hdr_off + 0x0e) range
        READ_SHORT (hdr_off + 0x26) projectile
      END
    BUT_ONLY
  END
END


/////////////////////////////////////////////////////////////////////
// HK_FIND_HLA (action)
// Finds a standard HLA in a class HLA table (LUFI0.2da for fighters,
// LUTH0.2da for thieves) by its English name, so kits can keep standard
// HLAs without hard-coding SPCL resrefs. Returns the row's columns
// (ability, icon, strref, min level, max level, picks, prerequisite)
// and the bare spell resref.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_FIND_HLA
  STR_VAR name  = ""
          table = "lufi0"
  RET found ability icon strref min_lev max_lev num_allowed prereq spell
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT prereq      ~*~
  OUTER_SPRINT ability     ~*~
  OUTER_SPRINT icon        ~*~
  OUTER_SPRINT strref      ~-1~
  OUTER_SPRINT min_lev     ~1~
  OUTER_SPRINT max_lev     ~99~
  OUTER_SPRINT num_allowed ~1~
  OUTER_SPRINT spell       ~~

  ACTION_IF (FILE_EXISTS_IN_GAME ~%table%.2da~) BEGIN
  COPY_EXISTING ~%table%.2da~ ~override~
    COUNT_2DA_COLS cols
    READ_2DA_ENTRIES_NOW ~hk_lu~ cols
    FOR (r = 0; r < hk_lu && found == 0; ++r) BEGIN
      READ_2DA_ENTRY_FORMER ~hk_lu~ r 1 res
      PATCH_IF (STRING_LENGTH ~%res%~ > 3) BEGIN
        // Strip the GA_ / AP_ prefix
        INNER_PATCH_SAVE spl ~%res%~ BEGIN
          DELETE_BYTES 0 3
        END
        PATCH_IF (FILE_EXISTS_IN_GAME ~%spl%.spl~) BEGIN
          INNER_PATCH_FILE ~%spl%.spl~ BEGIN
            READ_LONG 0x08 nm
          END
          PATCH_IF (nm > 0) BEGIN
            GET_STRREF nm txt
            PATCH_IF (~%txt%~ STRING_EQUAL_CASE ~%name%~) BEGIN
              SET found = 1
              SPRINT spell ~%spl%~
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 1 ability
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 2 icon
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 3 strref
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 4 min_lev
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 5 max_lev
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 6 num_allowed
              READ_2DA_ENTRY_FORMER ~hk_lu~ r 7 prereq
            END
          END
        END
      END
    END
  BUT_ONLY
  END

  ACTION_IF (found == 0) BEGIN
    OUTER_SPRINT hk_hla_name  ~%name%~
    OUTER_SPRINT hk_hla_table ~%table%~
    WARN @2
  END
END


/////////////////////////////////////////////////////////////////////
// HK_WEAPPROF_LINE (action)
// Builds the WEAPPROF.2da line for ADD_KIT, one value per proficiency
// row, in the game's own row order (so the row count is never guessed).
//   base:     class column to copy from (FIGHTER, CLERIC, THIEF...)
//   copy_all: 0 = copy only the fighting-style rows from the base column;
//             1 = copy every row from the base column
//   skilled:  proficiency row names raised to `pips`
//   pips:     5 = grandmastery, 3 = mastery, 2 = specialisation
//   cap:      copied rows (other than fighting styles) are capped at
//             this many pips; 0 = no cap
//   none:     proficiency row names forced to 0
//   skilled2/pips2, skilled3/pips3: further sets of rows at other
//             levels (for example mastery, 3, alongside grandmastery)
// Everything else is 0.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_WEAPPROF_LINE
  INT_VAR copy_all = 0
          pips     = 5
          cap      = 0
          pips2    = 3
          pips3    = 1
  STR_VAR kit      = ""
          base     = "FIGHTER"
          skilled  = ""
          none     = ""
          skilled2 = ""
          skilled3 = ""
          styles   = "2HANDED SWORDANDSHIELD SINGLEWEAPON 2WEAPON"
  RET line
BEGIN
  OUTER_SPRINT line ~%kit%~
  OUTER_SET hk_wp_matched  = 0
  OUTER_SET hk_wp_expected = 0
  OUTER_PATCH ~ %skilled% %skilled2% %skilled3% ~ BEGIN
    REPLACE_EVALUATE ~[^ ]+~ BEGIN SET hk_wp_expected += 1 END ~%MATCH0%~
  END

  COPY_EXISTING ~weapprof.2da~ ~override~
    COUNT_2DA_COLS cols
    // Header row has one token fewer than data rows (no row label)
    SET base_col = "-1"
    FOR (c = 0; c < cols - 1; ++c) BEGIN
      READ_2DA_ENTRY 0 c (cols - 1) head
      PATCH_IF (~%head%~ STRING_EQUAL_CASE ~%base%~) BEGIN
        SET base_col = c + 1
      END
    END
    PATCH_IF (base_col < 0) BEGIN
      PATCH_FAIL ~Halfling Kits: no %base% column in WEAPPROF.2da.~
    END
    READ_2DA_ENTRIES_NOW ~hk_wp~ cols
    FOR (r = 0; r < hk_wp; ++r) BEGIN
      READ_2DA_ENTRY_FORMER ~hk_wp~ r 0 label
      SET value = 0
      SET is_style = (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %label% ~ ~ %styles% ~) >= 0)
      PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %label% ~ ~ %none% ~) >= 0) BEGIN
        SET value = 0
      END ELSE PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %label% ~ ~ %skilled% ~) >= 0) BEGIN
        SET value = pips
        SET hk_wp_matched += 1
      END ELSE PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %label% ~ ~ %skilled2% ~) >= 0) BEGIN
        SET value = pips2
        SET hk_wp_matched += 1
      END ELSE PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %label% ~ ~ %skilled3% ~) >= 0) BEGIN
        SET value = pips3
        SET hk_wp_matched += 1
      END ELSE PATCH_IF (copy_all || is_style) BEGIN
        READ_2DA_ENTRY_FORMER ~hk_wp~ r base_col value
        PATCH_IF (cap > 0 && NOT is_style && value > cap) BEGIN
          SET value = cap
        END
      END
      SPRINT line ~%line% %value%~
    END
  BUT_ONLY

  ACTION_IF (hk_wp_matched != hk_wp_expected) BEGIN
    WARN @3
  END
END


/////////////////////////////////////////////////////////////////////
// HK_STAT_LINE (action)
// Builds an ability-score line for ADD_KIT (ABCLASRQ.2da) from the
// file's own column names, so the column order is never guessed.
//   values: space-separated NAME=value pairs, e.g. ~WIS=9~; others 0
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_STAT_LINE
  STR_VAR kit    = ""
          file   = "abclasrq.2da"
          values = ""
  RET line
BEGIN
  OUTER_SPRINT line ~%kit%~
  OUTER_SET hk_st_expected = 0
  OUTER_SET hk_st_matched  = 0
  OUTER_PATCH ~ %values% ~ BEGIN
    REPLACE_EVALUATE ~[^ ]+=[0-9]+~ BEGIN SET hk_st_expected += 1 END ~%MATCH0%~
  END
  COPY_EXISTING ~%file%~ ~override~
    COUNT_2DA_COLS cols
    FOR (c = 0; c < cols - 1; ++c) BEGIN
      READ_2DA_ENTRY 0 c (cols - 1) head
      SET value = 0
      INNER_PATCH ~ %values% ~ BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~ %head%=\([0-9]+\) ~ BEGIN
          SET value = MATCH1
          SET hk_st_matched += 1
        END ~~
      END
      SPRINT line ~%line% %value%~
    END
  BUT_ONLY
  // A name that matches no column would silently drop a requirement
  ACTION_IF (hk_st_matched != hk_st_expected) BEGIN
    FAIL ~Halfling Kits: not every ability in "%values%" matched a column of %file%.~
  END
END


/////////////////////////////////////////////////////////////////////
// HK_EMPTY_COLUMN_LINE (action)
// A line of "*", one per data row of a column-wise 2DA (25STWEAP.2da),
// for kits that start with no special equipment.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_EMPTY_COLUMN_LINE
  STR_VAR file = ""
  RET line
BEGIN
  OUTER_SPRINT line ~~
  ACTION_IF (FILE_EXISTS_IN_GAME ~%file%~) BEGIN
    COPY_EXISTING ~%file%~ ~override~
      COUNT_2DA_COLS cols
      COUNT_2DA_ROWS cols rows
      FOR (r = 0; r < rows; ++r) BEGIN
        SPRINT line ~%line% *~
      END
    BUT_ONLY
  END
END


/////////////////////////////////////////////////////////////////////
// HK_RESTRICT_ITEMS (action)
// Makes items unusable by one kit (opcode 319, power 0 = matching
// creatures cannot use it). Used for kit weapon and armour limits that
// the vanilla usability flags cannot express.
//   kit_id:          the kit's KIT.IDS value
//   message:         strref shown when the restriction blocks the item
//   allowed_profs:   space-separated proficiency IDs the kit may wield;
//                    any other weapon is blocked (ammunition is skipped);
//                    empty = no weapon limits
//   min_base_ac:     armour that sets base AC below this is blocked
//                    (4 allows splint mail, blocks plate and full plate)
//   max_shield_size: shields above this size are blocked
//                    (D1 buckler, D2 small, D3 medium, D4 large)
//   forbidden_types: space-separated item types blocked outright
//                    (2 armour, 4 boots, 7 helmets, 12 shields)
//   forbidden_profs: space-separated proficiency IDs blocked outright
//   name_types/name_deny: items of these types whose English name
//                    matches the regexp are blocked (e.g. heavy crossbows)
//   magical_types:   items of these types are blocked if flagged magical
//                    (flag 0x40), e.g. 1 amulets, 10 rings, 32 cloaks
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_RESTRICT_ITEMS
  INT_VAR kit_id          = 0
          message         = "-1"
          min_base_ac     = "-100"
          max_shield_size = 4
  STR_VAR allowed_profs   = ""
          forbidden_types = ""
          forbidden_profs = ""
          name_types      = ""
          name_deny       = ""
          magical_types   = ""
BEGIN
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
      READ_SHORT 0x1c item_type
      READ_BYTE  0x31 prof
      READ_ASCII 0x22 anim (2)
      SET restrict = 0

      // Weapons: blocked unless their proficiency is allowed. Arrows (5),
      // bullets (14) and bolts (31) follow their launcher.
      PATCH_IF (NOT ~%allowed_profs%~ STRING_EQUAL ~~ &&
                item_type != 5 && item_type != 14 && item_type != 31 &&
                prof >= 89 && prof <= 115) BEGIN
        PATCH_IF (INDEX (EXACT_MATCH ~ %prof% ~ ~ %allowed_profs% ~) < 0) BEGIN
          SET restrict = 1
        END
      END

      PATCH_IF (INDEX (EXACT_MATCH ~ %item_type% ~ ~ %forbidden_types% ~) >= 0) BEGIN
        SET restrict = 1
      END
      PATCH_IF (item_type != 5 && item_type != 14 && item_type != 31 &&
                INDEX (EXACT_MATCH ~ %prof% ~ ~ %forbidden_profs% ~) >= 0) BEGIN
        SET restrict = 1
      END
      PATCH_IF (INDEX (EXACT_MATCH ~ %item_type% ~ ~ %magical_types% ~) >= 0) BEGIN
        READ_LONG 0x18 item_flags
        PATCH_IF (item_flags & 0x40) BEGIN
          SET restrict = 1
        END
      END
      PATCH_IF (NOT ~%name_deny%~ STRING_EQUAL ~~ &&
                INDEX (EXACT_MATCH ~ %item_type% ~ ~ %name_types% ~) >= 0) BEGIN
        READ_LONG 0x0c nm
        PATCH_IF (nm <= 0) BEGIN
          READ_LONG 0x08 nm
        END
        PATCH_IF (nm > 0) BEGIN
          GET_STRREF nm txt
          PATCH_IF (INDEX (CASE_INSENSITIVE EVALUATE_REGEXP ~%name_deny%~ ~%txt%~) >= 0) BEGIN
            SET restrict = 1
          END
        END
      END

      // Shields (12): size from the paperdoll animation, D1 to D4
      PATCH_IF (item_type == 12) BEGIN
        INNER_PATCH ~%anim%~ BEGIN
          READ_BYTE 0 letter
          READ_BYTE 1 digit
        END
        PATCH_IF ((letter == 68 || letter == 100) && (digit - 48) > max_shield_size) BEGIN
          SET restrict = 1
        END
      END

      // Armour (2): heaviness from the equipped "set base AC" effect
      // (opcode 0, type 16). Enchantment is a separate effect.
      PATCH_IF (item_type == 2) BEGIN
        READ_LONG  0x6a fx_off
        READ_SHORT 0x6e fx_idx
        READ_SHORT 0x70 fx_cnt
        FOR (i = fx_idx; i < fx_idx + fx_cnt; ++i) BEGIN
          READ_SHORT (fx_off + i * 0x30)     op
          READ_SLONG (fx_off + i * 0x30 + 4) p1
          READ_LONG  (fx_off + i * 0x30 + 8) p2
          PATCH_IF (op == 0 && p2 == 16 && p1 < min_base_ac) BEGIN
            SET restrict = 1
          END
        END
      END

      PATCH_IF (restrict) BEGIN
        LPF ADD_ITEM_EQEFFECT
          INT_VAR opcode     = 319
                  target     = 1
                  timing     = 2
                  parameter1 = kit_id
                  parameter2 = 9      // KIT.IDS
                  power      = 0      // matching creatures cannot use it
                  special    = message
        END
      END
    END
  BUT_ONLY
END


/////////////////////////////////////////////////////////////////////
// HK_ALIGNMENT_LINE (action)
// Builds the ALIGNMNT.2da line for ADD_KIT from the file's own column
// names, so the column order is never guessed.
//   allowed:  space-separated column names, e.g. ~CHAOTIC_GOOD~, or ~*~
//             for all
//   copy_row: instead, copy an existing row, e.g. ~THIEF~
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_ALIGNMENT_LINE
  STR_VAR kit      = ""
          allowed  = ""
          copy_row = ""
  RET line
BEGIN
  OUTER_SPRINT line ~%kit%~
  OUTER_SET hk_al_matched  = 0
  OUTER_SET hk_al_expected = 1   // copy_row or "*": at least one match
  ACTION_IF (~%copy_row%~ STRING_EQUAL ~~ && NOT ~%allowed%~ STRING_EQUAL ~*~) BEGIN
    OUTER_SET hk_al_expected = 0
    OUTER_PATCH ~ %allowed% ~ BEGIN
      REPLACE_EVALUATE ~[^ ]+~ BEGIN SET hk_al_expected += 1 END ~%MATCH0%~
    END
  END
  COPY_EXISTING ~alignmnt.2da~ ~override~
    COUNT_2DA_COLS cols
    PATCH_IF (NOT ~%copy_row%~ STRING_EQUAL ~~) BEGIN
      READ_2DA_ENTRIES_NOW ~hk_al~ cols
      FOR (r = 0; r < hk_al; ++r) BEGIN
        READ_2DA_ENTRY_FORMER ~hk_al~ r 0 label
        PATCH_IF (hk_al_matched == 0 && ~%label%~ STRING_EQUAL_CASE ~%copy_row%~) BEGIN
          SET hk_al_matched = 1
          FOR (c = 1; c < cols; ++c) BEGIN
            READ_2DA_ENTRY_FORMER ~hk_al~ r c value
            SPRINT line ~%line% %value%~
          END
        END
      END
    END ELSE BEGIN
      FOR (c = 0; c < cols - 1; ++c) BEGIN
        READ_2DA_ENTRY 0 c (cols - 1) head
        PATCH_IF (~%allowed%~ STRING_EQUAL ~*~ ||
                  INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %head% ~ ~ %allowed% ~) >= 0) BEGIN
          SPRINT line ~%line% 1~
          SET hk_al_matched += 1
        END ELSE BEGIN
          SPRINT line ~%line% 0~
        END
      END
    END
  BUT_ONLY
  ACTION_IF (hk_al_matched == 0 ||
             (~%allowed%~ STRING_COMPARE ~*~ && ~%copy_row%~ STRING_EQUAL ~~ && hk_al_matched < hk_al_expected)) BEGIN
    FAIL ~Halfling Kits: not every alignment in "%allowed%%copy_row%" matched ALIGNMNT.2da.~
  END
END


/////////////////////////////////////////////////////////////////////
// HK_HLA_ROW (action)
// Appends one row to an HLA table (LU*.2da) being built in a variable.
// Rows are numbered from 1 by the running counter `number`.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_HLA_ROW
  INT_VAR number    = 0
          strref    = "-1"
          picks     = 1
          min_level = 1
          max_level = 99
  STR_VAR rows      = ""
          ability   = ""
          icon      = "*"
          prereq    = "*"
  RET rows number
BEGIN
  ACTION_IF (~%icon%~ STRING_EQUAL ~~) BEGIN
    OUTER_SPRINT icon ~*~
  END
  OUTER_SET number += 1
  OUTER_SPRINT rows ~%rows%%number% %ability% %icon% %strref% %min_level% %max_level% %picks% %prereq% * *%LNL%~
END



/////////////////////////////////////////////////////////////////////
// HK_INIT_EFF (patch)
// Fills a freshly CREATEd EFF V2.0 file (CREATE EFF ~name~).
/////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION HK_INIT_EFF
  INT_VAR opcode        = 0
          target        = 1
          parameter1    = 0
          parameter2    = 0
          timing        = 0
          duration      = 0
          resist_dispel = 0
          special       = 0
          savingthrow   = 0
  STR_VAR resource      = ""
BEGIN
  WRITE_LONG   0x10 opcode
  WRITE_LONG   0x14 target
  WRITE_LONG   0x18 0           // power
  WRITE_LONG   0x1c parameter1
  WRITE_LONG   0x20 parameter2
  WRITE_SHORT  0x24 timing
  WRITE_LONG   0x28 duration
  WRITE_SHORT  0x2c 100         // probability 1
  WRITE_SHORT  0x2e 0           // probability 2
  WRITE_ASCIIE 0x30 ~%resource%~ #8
  WRITE_LONG   0x40 savingthrow
  WRITE_LONG   0x48 special
  WRITE_LONG   0x5c resist_dispel
END


/////////////////////////////////////////////////////////////////////
// HK_FIND_KIT_ABILITY (action)
// Finds a vanilla kit's innate ability by its English name, looking
// through that kit's CLAB file (named in KITLIST.2da). Used to reuse
// abilities such as the Shadowdancer's Shadowstep.
//   kit:  KITLIST.2da row name, e.g. ~SHADOWDANCER~
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_FIND_KIT_ABILITY
  STR_VAR kit  = ""
          name = ""
  RET found spell
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT spell ~~
  OUTER_SPRINT clab  ~~

  COPY_EXISTING ~kitlist.2da~ ~override~
    COUNT_2DA_COLS cols
    READ_2DA_ENTRIES_NOW ~hk_kl~ cols
    FOR (r = 0; r < hk_kl; ++r) BEGIN
      READ_2DA_ENTRY_FORMER ~hk_kl~ r 1 row_name
      PATCH_IF (~%row_name%~ STRING_EQUAL_CASE ~%kit%~) BEGIN
        READ_2DA_ENTRY_FORMER ~hk_kl~ r 5 clab   // ABILITIES column
      END
    END
  BUT_ONLY

  ACTION_IF (NOT ~%clab%~ STRING_EQUAL ~~ && FILE_EXISTS_IN_GAME ~%clab%.2da~) BEGIN
    COPY_EXISTING ~%clab%.2da~ ~override~
      COUNT_2DA_COLS cols
      READ_2DA_ENTRIES_NOW ~hk_cl~ cols
      FOR (r = 0; r < hk_cl && found == 0; ++r) BEGIN
        FOR (c = 1; c < cols && found == 0; ++c) BEGIN
          READ_2DA_ENTRY_FORMER ~hk_cl~ r c res
          PATCH_IF (STRING_LENGTH ~%res%~ > 3) BEGIN
            INNER_PATCH_SAVE spl ~%res%~ BEGIN
              DELETE_BYTES 0 3
            END
            PATCH_IF (FILE_EXISTS_IN_GAME ~%spl%.spl~) BEGIN
              INNER_PATCH_FILE ~%spl%.spl~ BEGIN
                READ_LONG 0x08 nm
              END
              PATCH_IF (nm > 0) BEGIN
                GET_STRREF nm txt
                PATCH_IF (~%txt%~ STRING_EQUAL_CASE ~%name%~) BEGIN
                  SET found = 1
                  SPRINT spell ~%spl%~
                END
              END
            END
          END
        END
      END
    BUT_ONLY
  END

  ACTION_IF (found == 0) BEGIN
    OUTER_SPRINT hk_ability_name ~%name%~
    OUTER_SPRINT hk_ability_kit  ~%kit%~
    WARN @4
  END
END


/////////////////////////////////////////////////////////////////////
// HK_ADD_IDS (action)
// Adds a symbol to an IDS file (once) with the next free number, and
// returns the number. Used for spell states (SPLSTATE.IDS) and creature
// tags (SPECIFIC.IDS). Both hold values up to 255.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_ADD_IDS
  INT_VAR max  = 255
  STR_VAR file = ""
          name = ""
  RET id
BEGIN
  OUTER_SET id = IDS_OF_SYMBOL (~%file%~ ~%name%~)
  ACTION_IF (id < 0) BEGIN
    OUTER_SET id = 0
    COPY_EXISTING ~%file%.ids~ ~override~
      READ_2DA_ENTRIES_NOW ~hk_ids~ 2
      FOR (r = 0; r < hk_ids; ++r) BEGIN
        READ_2DA_ENTRY_FORMER ~hk_ids~ r 0 value
        PATCH_IF (IS_AN_INT value && value >= id) BEGIN
          SET id = value + 1
        END
      END
    BUT_ONLY
    ACTION_IF (id > max) BEGIN
      FAIL ~Halfling Kits: %file%.IDS is full; cannot add %name%.~
    END
    APPEND ~%file%.ids~ ~%id% %name%~
  END
END


/////////////////////////////////////////////////////////////////////
// HK_ADD_SPELLSTATE (action)
// Adds a spell state to SPLSTATE.IDS (once) and returns its number.
// Spell states let one spell check whether another has been applied
// (opcode 328 sets it; SPLPROT rows 110/111 test it).
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_ADD_SPELLSTATE
  STR_VAR name = ""
  RET id
BEGIN
  LAF HK_ADD_IDS STR_VAR file = ~splstate~ name = EVAL ~%name%~ RET id END
END


/////////////////////////////////////////////////////////////////////
// HK_FIND_SPELL_BY_NAME (action)
// Finds a vanilla spell by its English name among files matching
// `pattern` (default: priest spells SPPRnnn), so kits can reuse spells
// such as Heal without hard-coding resrefs. Returns the first match.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_FIND_SPELL_BY_NAME
  STR_VAR name    = ""
          pattern = "^sppr[0-9][0-9][0-9]\.spl$"
  RET found spell
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT spell ~~
  COPY_EXISTING_REGEXP GLOB ~%pattern%~ ~override~
    PATCH_IF (found == 0 && SOURCE_SIZE > 0x71) BEGIN
      READ_LONG 0x08 nm
      PATCH_IF (nm > 0) BEGIN
        GET_STRREF nm txt
        PATCH_IF (~%txt%~ STRING_EQUAL_CASE ~%name%~) BEGIN
          SET found = 1
          SPRINT spell ~%SOURCE_RES%~
        END
      END
    END
  BUT_ONLY
  ACTION_IF (found == 0) BEGIN
    OUTER_SPRINT hk_ability_name ~%name%~
    OUTER_SPRINT hk_ability_kit  ~spell~
    WARN @4
  END
END


/////////////////////////////////////////////////////////////////////
// HK_INNATE_COPY (action)
// Copies a spell as an innate ability under a new name, keeping its
// effects, level scaling and description.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_INNATE_COPY
  INT_VAR name   = "-1"
  STR_VAR source = ""
          dest   = ""
BEGIN
  COPY_EXISTING ~%source%.spl~ ~override/%dest%.spl~
    WRITE_SHORT 0x1c 4      // innate
    PATCH_IF (name >= 0) BEGIN
      WRITE_LONG 0x08 name
    END
    LPF ALTER_SPELL_HEADER INT_VAR location = 4 END
END


/////////////////////////////////////////////////////////////////////
// HK_READ_EFFECT_RESOURCE (action)
// Returns the resource of the first effect with the given opcode in a
// spell's first ability header (for example, the trap spell that Set
// Snare, SPCL412, sets with opcode 252).
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_READ_EFFECT_RESOURCE
  INT_VAR opcode = 0
  STR_VAR spell  = ""
  RET found resource
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT resource ~~
  ACTION_IF (FILE_EXISTS_IN_GAME ~%spell%.spl~) BEGIN
    COPY_EXISTING ~%spell%.spl~ ~override~
      READ_LONG  0x64 hdr_off
      READ_SHORT 0x68 hdr_cnt
      READ_LONG  0x6a fx_off
      PATCH_IF (hdr_cnt > 0) BEGIN
        READ_SHORT (hdr_off + 0x1e) cnt
        READ_SHORT (hdr_off + 0x20) idx
        FOR (i = idx; i < idx + cnt && found == 0; ++i) BEGIN
          READ_SHORT (fx_off + i * 0x30) op
          PATCH_IF (op == opcode) BEGIN
            SET found = 1
            READ_ASCII (fx_off + i * 0x30 + 0x14) resource (8) NULL
          END
        END
      END
    BUT_ONLY
  END
END


/////////////////////////////////////////////////////////////////////
// HK_RESTRICT_ARMOUR_BY_NAME (action)
// The game doesn't record what armour is made of, so armour (item type
// 2) is classified by its English name: names matching `allow` (and
// not `deny`) stay usable, everything else is made unusable by the kit.
// An override table (two columns: resref, ALLOW or DENY) corrects any
// item the names get wrong; it may be empty.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_RESTRICT_ARMOUR_BY_NAME
  INT_VAR kit_id    = 0
          message   = "-1"
  STR_VAR allow     = ""
          deny      = ""
          overrides = ""   // path to the override table in the mod folder
BEGIN
  ACTION_CLEAR_ARRAY hk_armour_override
  ACTION_IF (NOT ~%overrides%~ STRING_EQUAL ~~ && FILE_EXISTS ~%overrides%~) BEGIN
    COPY - ~%overrides%~ ~override~
      READ_2DA_ENTRIES_NOW ~hk_ao~ 2
      FOR (r = 0; r < hk_ao; ++r) BEGIN
        READ_2DA_ENTRY_FORMER ~hk_ao~ r 0 res
        READ_2DA_ENTRY_FORMER ~hk_ao~ r 1 rule
        TO_UPPER res
        TO_UPPER rule
        DEFINE_ASSOCIATIVE_ARRAY hk_armour_override BEGIN ~%res%~ => ~%rule%~ END
      END
  END

  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
      READ_SHORT 0x1c item_type
      PATCH_IF (item_type == 2) BEGIN
        SPRINT res ~%SOURCE_RES%~
        TO_UPPER res
        SET natural = 0
        PATCH_IF (VARIABLE_IS_SET $hk_armour_override(~%res%~)) BEGIN
          SPRINT rule $hk_armour_override(~%res%~)
          SET natural = (~%rule%~ STRING_EQUAL ~ALLOW~)
        END ELSE BEGIN
          READ_LONG 0x0c nm
          PATCH_IF (nm <= 0) BEGIN
            READ_LONG 0x08 nm
          END
          PATCH_IF (nm > 0) BEGIN
            GET_STRREF nm txt
            SET natural = (INDEX (CASE_INSENSITIVE EVALUATE_REGEXP ~%allow%~ ~%txt%~) >= 0 &&
                           (~%deny%~ STRING_EQUAL ~~ ||
                            INDEX (CASE_INSENSITIVE EVALUATE_REGEXP ~%deny%~ ~%txt%~) < 0))
          END
        END
        PATCH_IF (NOT natural) BEGIN
          LPF ADD_ITEM_EQEFFECT
            INT_VAR opcode = 319 target = 1 timing = 2
                    parameter1 = kit_id parameter2 = 9 power = 0 special = message
          END
        END
      END
    END
  BUT_ONLY
END


/////////////////////////////////////////////////////////////////////
// HK_FIND_CRE_BY_NAME (action)
// Finds a vanilla creature by its English name, so kits can copy one
// (a cave bear, a treant) without hard-coding resrefs.
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_FIND_CRE_BY_NAME
  INT_VAR quiet = 0   // 1 = no warning if not found (when there's a fallback)
  STR_VAR name = ""
  RET found cre
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT cre ~~
  COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
    PATCH_IF (found == 0 && SOURCE_SIZE > 0x2d3) BEGIN
      READ_LONG 0x08 nm
      PATCH_IF (nm > 0) BEGIN
        GET_STRREF nm txt
        PATCH_IF (~%txt%~ STRING_EQUAL_CASE ~%name%~) BEGIN
          SET found = 1
          SPRINT cre ~%SOURCE_RES%~
        END
      END
    END
  BUT_ONLY
  ACTION_IF (found == 0 && NOT quiet) BEGIN
    OUTER_SPRINT hk_ability_name ~%name%~
    OUTER_SPRINT hk_ability_kit  ~creature~
    WARN @4
  END
END


/////////////////////////////////////////////////////////////////////
// HK_SUMMON_COPY (patch)
// Turns a copied vanilla creature into a clean summon: new name, hit
// points and AC; no scripts, dialogue, death variable or XP value, so
// it can't trigger the original's quest logic.
/////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION HK_SUMMON_COPY
  INT_VAR name = "-1"
          hp   = 0      // 0 = keep
          ac   = 100    // 100 = keep
BEGIN
  PATCH_IF (name >= 0) BEGIN
    WRITE_LONG 0x08 name
    WRITE_LONG 0x0c name
  END
  PATCH_IF (hp > 0) BEGIN
    WRITE_SHORT 0x24 hp
    WRITE_SHORT 0x26 hp
  END
  PATCH_IF (ac != 100) BEGIN
    WRITE_SHORT  0x46 ac
    WRITE_SHORT  0x48 ac
  END
  WRITE_LONG 0x14 0                                   // XP value
  FOR (off = 0x248; off < 0x270; off += 8) BEGIN      // override, class, race, general, default scripts
    WRITE_ASCII off ~~ #8
  END
  WRITE_ASCII 0x280 ~~ #32                            // death variable
  WRITE_ASCII 0x2cc ~~ #8                             // dialogue
END


/////////////////////////////////////////////////////////////////////
// HK_FIND_ITEM_BY_NAME (action)
// Finds a vanilla item of one item type whose English identified name
// (or, failing that, unidentified name) matches a regexp, so kits can
// use items such as gems without hard-coding resrefs.
//   type:   item type (34 = gems)
//   quiet:  1 = no warning if not found
//   regexp: matched against the whole name, case-insensitive
/////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION HK_FIND_ITEM_BY_NAME
  INT_VAR type   = 34
          quiet  = 0
  STR_VAR regexp = ""
          label  = ""   // the name shown in the warning
  RET found itm
BEGIN
  OUTER_SET found = 0
  OUTER_SPRINT itm ~~
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (found == 0 && SOURCE_SIZE > 0x71) BEGIN
      READ_SHORT 0x1c item_type
      PATCH_IF (item_type == type) BEGIN
        FOR (off = 0x0c; off >= 0x08 && found == 0; off -= 4) BEGIN
          READ_LONG off nm
          PATCH_IF (nm > 0) BEGIN
            GET_STRREF nm txt
            PATCH_IF (NOT (~%txt%~ STRING_MATCHES_REGEXP ~^%regexp%$~)) BEGIN
              SET found = 1
              SPRINT itm ~%SOURCE_RES%~
            END
          END
        END
      END
    END
  BUT_ONLY
  ACTION_IF (found == 0 && NOT quiet) BEGIN
    OUTER_SPRINT hk_ability_name ~%label%~
    OUTER_SPRINT hk_ability_kit  ~item~
    WARN @4
  END
END
