// Slinger: craft bullets when the party rests in a city, town or building
// (not a dungeon), once a day per kind, from a gem the Slinger carries.
// Added to the global scripts once per party slot (%hk_player%, %hk_slot%).
// The enhanced batch is made when the Slinger has the Enhanced HLA and
// carries the costly gem; otherwise the standard batch from the common gem.

IF
  PartyRested()
  Kit(%hk_player%,HK_SLINGER)
  CheckSpellState(%hk_player%,HK_SL_DISPEL2)
  HasItem("%hk_gem_star%",%hk_player%)
  !GlobalTimerNotExpired("HKSLD%hk_slot%","GLOBAL")
  OR(2)
    AreaType(CITY)
    !AreaType(OUTDOOR)
  !AreaType(DUNGEON)
THEN
  RESPONSE #100
    SetGlobalTimer("HKSLD%hk_slot%","GLOBAL",7200)
    ActionOverride(%hk_player%,DestroyItem("%hk_gem_star%"))
    ActionOverride(%hk_player%,ApplySpellRES("HKSLCD2",Myself))
    Continue()
END

IF
  PartyRested()
  Kit(%hk_player%,HK_SLINGER)
  CheckSpellState(%hk_player%,HK_SL_DISPEL)
  OR(2)
    !CheckSpellState(%hk_player%,HK_SL_DISPEL2)
    !HasItem("%hk_gem_star%",%hk_player%)
  HasItem("%hk_gem_moon%",%hk_player%)
  !GlobalTimerNotExpired("HKSLD%hk_slot%","GLOBAL")
  OR(2)
    AreaType(CITY)
    !AreaType(OUTDOOR)
  !AreaType(DUNGEON)
THEN
  RESPONSE #100
    SetGlobalTimer("HKSLD%hk_slot%","GLOBAL",7200)
    ActionOverride(%hk_player%,DestroyItem("%hk_gem_moon%"))
    ActionOverride(%hk_player%,ApplySpellRES("HKSLCD1",Myself))
    Continue()
END

