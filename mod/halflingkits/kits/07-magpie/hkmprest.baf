// Magpie: Brandobaris's Gift and Brandobaris's Dice.
// Added to the global scripts once per party slot (%hk_player%, %hk_slot%).
// The Gift: once a day on any rest. The Dice: once a day on a rest in a
// city or a building that isn't a dungeon; 60% to win, 40% to lose, an
// amount by level band. The win blocks don't Continue(), so when one
// fires the lose blocks are not reached; when none fires, a lose block does.

IF
  PartyRested()
  Kit(%hk_player%,HK_MAGPIE)
  !GlobalTimerNotExpired("HKMPG%hk_slot%","GLOBAL")
THEN
  RESPONSE #100
    SetGlobalTimer("HKMPG%hk_slot%","GLOBAL",7200)
    ActionOverride(%hk_player%,ApplySpellRES("HKMPGIFT",Myself))
    Continue()
END

IF
  PartyRested()
  Kit(%hk_player%,HK_MAGPIE)
  !GlobalTimerNotExpired("HKMPD%hk_slot%","GLOBAL")
  OR(2)
    AreaType(CITY)
    !AreaType(OUTDOOR)
  !AreaType(DUNGEON)
  LevelGT(%hk_player%,0)
  LevelLT(%hk_player%,5)
  RandomNumLT(100,61)
THEN
  RESPONSE #100
    SetGlobalTimer("HKMPD%hk_slot%","GLOBAL",7200)
    GivePartyGold(100)
    DisplayStringHead(%hk_player%,%hk_mp_win%)
END

